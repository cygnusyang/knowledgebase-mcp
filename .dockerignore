# Keep the build context small and stop host artifacts from shadowing what the
# image builds itself. `dist/` matters most: copying a stale host build over the
# freshly compiled one would ship code that does not match the sources.
node_modules/
dist/
.git/
.gitignore
.kilo/
.claude/

# Never send local credentials into the build context.
.env
.env.local
.env.*.local

*.log
npm-debug.log*
*.tsbuildinfo
.DS_Store
.idea/
.vscode/

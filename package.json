{
  "name": "knowledgebase-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server exposing knowledge-base tools over Obsidian Local REST API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cygnusyang/knowledgebase-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "obsidian",
    "knowledge-base",
    "claude"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "knowledgebase-mcp": "dist/src/server.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/src/server.js",
    "test": "tsc && node --test dist/tests/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2"
  }
}
